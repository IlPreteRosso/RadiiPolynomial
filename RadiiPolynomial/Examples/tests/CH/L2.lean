/-! ### The bundle -/

/-- The genuine `StdChebIVPData` bundle (`habar_size`, `hν`, `Fact (1 ≤ ν)` all discharged). -/
def d2 : ChebyshevIVP.StdChebIVPData ν2 2 N2 where
  A_col l j k := (AFlat.getD (2 * (l : ℕ) + (j : ℕ)) #[]).getD k #[]
  DF_col l j k := (DFFlat.getD (2 * (l : ℕ) + (j : ℕ)) #[]).getD k #[]
  abar_Q l := abarArr.getD (l : ℕ) #[]
  ν_q := 3 / 2
  hν := ν2_eq_q
  habar_size := fun l => by fin_cases l <;> rfl

/-! ### Certificate numbers (every slot an override `≥` its generated majorant) -/

/-- `Y₀ = 10⁻⁶`, `Z₀ = 0` (exact inverse), `R = (7/20, 13/100)`, `K = 7/5`, `ε = 13/50`,
`Z₁ = ε + (ν/(N+1))·K = 14/25`, `C = 3`, `B = 8`, `Z₂ = C·B = 24`, `r₀ = 10⁻⁵`. -/
def cert2 : ChebCertQ 2 where
  Y₀ := 1 / 1000000
  Z₀ := 0
  Z₁ := 14 / 25
  Z₂ := 24
  r₀ := 1 / 100000
  R := ![7 / 20, 13 / 100]
  K := 7 / 5
  ε := 13 / 50
  C := 3
  B := 8

/-- The ONE ℚ-decidable obligation, closed by the kernel (no `native_decide`). -/
theorem checks2 : cert2.Checks N2 d2.A_col d2.DF_col d2.abar_Q d2.ν_q f2 p_q := by
  decide +kernel

/-- Per-block leakage certificate data for the kernel-scale checker (each entry `≥` the
generated `epsBlockGen` of its block; row sums `0.192`, `0.254` `≤ ε = 0.26`). -/
def E2 : Fin 2 → Fin 2 → ℚ := ![![27 / 200, 57 / 1000], ![117 / 1000, 137 / 1000]]

/-- The same bundle through the kernel-scale obligations (one `decide +kernel`). `Z₀ = 0` (exact
inverse): the exact-columns slot keeps exact zeros, so it certifies `Z₀ = 0`; the grid slot carries
`L (N + 1)` grid units of slack per entry. -/
theorem checksK2 : cert2.ChecksK .exactCols (10 ^ 60) E2 N2 d2.A_col d2.DF_col d2.abar_Q d2.ν_q f2 p_q := by
  decide +kernel

/-- `L = 2` through the kernel-scale face. -/
theorem l2_main_kernel :
    ∃! x ∈ Metric.closedBall d2.abar ((cert2.r₀ : ℚ) : ℝ), d2.G (banachField f2) p₀ x = 0 :=
  certified_of_checksK d2 f2 p₀ p_q hp cert2 E2 .exactCols (10 ^ 60) checksK2

/-- End-to-end `L = 2` certificate through the family face. -/
theorem l2_main :
    ∃! x ∈ Metric.closedBall d2.abar ((cert2.r₀ : ℚ) : ℝ), d2.G (banachField f2) p₀ x = 0 :=
  certified_of_checks d2 f2 p₀ p_q hp cert2 checks2

/-! ### The semantic bridges fire at `L = 2` (explicit instantiations at `d2`) -/

/-- The `Z₁` operator bound at `d2`, produced by `Z₁_le_of_Q` from the checked components. -/
theorem l2_Z₁ :
    ‖d2.composedApproxCLM - fderiv ℝ (d2.G (banachField f2) p₀) d2.abar‖ ≤
      ((cert2.Z₁ : ℚ) : ℝ) :=
  Z₁_le_of_Q d2 f2 p₀ checks2.2.2.1 checks2.2.2.2.1 checks2.2.2.2.2.1 checks2.2.2.2.2.2.1

/-- The `Z₂` Lipschitz bound at `d2`, produced by `Z₂_le_of_Q`. -/
theorem l2_Z₂ :
    ∀ c ∈ Metric.closedBall d2.abar ((cert2.r₀ : ℚ) : ℝ),
      ‖fderiv ℝ (d2.G (banachField f2) p₀) c - fderiv ℝ (d2.G (banachField f2) p₀) d2.abar‖
        ≤ ((cert2.Z₂ : ℚ) : ℝ) * ((cert2.r₀ : ℚ) : ℝ) :=
  Z₂_le_of_Q d2 f2 p₀ checks2.2.2.1 checks2.2.2.2.2.2.2.2.2.2.1.le checks2.2.2.2.2.2.2.1
    checks2.2.2.2.2.2.2.2.1 checks2.2.2.2.2.2.2.2.2.1

/-- The generic `TC` operator bound at `d2` (block sum over BOTH `j`, off-diagonal included). -/
theorem l2_TC (w : XCheb ν2 2) :
    ‖d2.TC w‖ ≤ (TCnormGen N2 d2.A_col d2.ν_q : ℝ) * ‖w‖ :=
  TC_norm_le_gen d2 w

/-- The same `certified_of_checks` conclusion with every bridge spelled out in the term
(grep-visible: `Y₀_le_of_Q` and `defect_finBlockNorm_le_of_Q` via `certified_of_Y₀Z₀`,
`Z₁_le_of_Q`, `Z₂_le_of_Q`). -/
theorem l2_main_explicit :
    ∃! x ∈ Metric.closedBall d2.abar ((cert2.r₀ : ℚ) : ℝ), d2.G (banachField f2) p₀ x = 0 :=
  certified_of_Y₀Z₀ d2 f2 p₀ p_q hp checks2.1 checks2.2.1 l2_Z₁ l2_Z₂
    checks2.2.2.2.2.2.2.2.2.2.1 checks2.2.2.2.2.2.2.2.2.2.2

/-- `hneg` at `d2` (negative modes, generic). -/
theorem l2_hneg (h : XCheb ν2 2) (l : Fin 2) (m : ℕ) :
    (((d2.composedApproxCLM - fderiv ℝ (d2.G (banachField f2) p₀) d2.abar) h) l)
      (Int.negSucc m) = 0 :=
  Z₁_hneg d2 f2 p₀ h l m

/-- `htail` at `d2` (modes `> N`, generic). -/
theorem l2_htail (h : XCheb ν2 2) (l : Fin 2) (m : ℕ) (hm : N2 < m) :
    ‖(((d2.composedApproxCLM - fderiv ℝ (d2.G (banachField f2) p₀) d2.abar) h) l) (↑m : ℤ)‖
      = ‖(chebyshevShiftDiv (compPolyDerivative f2 d2.abar h l)) (↑m : ℤ)‖ :=
  Z₁_htail d2 f2 p₀ h l m hm

/-! ### Materiality witnesses (kernel-checked): the off-diagonal data are genuinely nonzero -/

/-- Both off-diagonal blocks of `DF(ā)`, of `A`, of the generated `TC` block constants and of
the generated ε-leakage are nonzero; `ā` has nonzero entries in both components. -/
theorem l2_offdiag_nonzero :
    (d2.DF_col 0 1 0).getD 1 0 ≠ 0 ∧ (d2.DF_col 1 0 0).getD 1 0 ≠ 0 ∧
    (d2.A_col 0 1 0).getD 1 0 ≠ 0 ∧ (d2.A_col 1 0 0).getD 1 0 ≠ 0 ∧
    0 < TCblockGen N2 d2.A_col d2.ν_q 0 1 ∧ 0 < TCblockGen N2 d2.A_col d2.ν_q 1 0 ∧
    0 < epsBlockGen N2 d2.A_col d2.DF_col d2.abar_Q d2.ν_q f2 0 1 ∧
    0 < epsBlockGen N2 d2.A_col d2.DF_col d2.abar_Q d2.ν_q f2 1 0 ∧
    (d2.abar_Q 0).getD 0 0 ≠ 0 ∧ (d2.abar_Q 1).getD 0 0 ≠ 0 := by
  decide +kernel

/-- The stored `DF` IS the polynomial's exact Jacobian at `ā` (audit, kernel-checked). -/
theorem l2_DF_is_jacobian : ∀ l m : Fin 2, ∀ k : Fin (N2 + 1),
    Array.ofFn (fun n : Fin (N2 + 1) => compPolyDFQ f2 d2.abar_Q l m n k) = d2.DF_col l m k := by
  decide +kernel

end Tests.CH
