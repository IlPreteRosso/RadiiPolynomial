/-! ### Parameters and the polynomial system -/

abbrev N2 : ℕ := 6

/-- The weight `ν = 3/2`. -/
noncomputable def ν2 : PosReal := ⟨3 / 2, by norm_num⟩

instance : Fact ((1 : ℝ) ≤ (ν2 : ℝ)) := ⟨by rw [show ((ν2 : ℝ)) = 3 / 2 from rfl]; norm_num⟩

theorem ν2_eq_q : (ν2 : ℝ) = (((3 / 2 : ℚ) : ℚ) : ℝ) := by
  rw [show ((ν2 : ℝ)) = 3 / 2 from rfl]; norm_num

/-- The cross-coupled system `u₀' = 1/10 + u₀ u₁`, `u₁' = −1/10 + u₀²`. -/
def f2 : Fin 2 → CompPoly 2 := fun l =>
  if l = 0 then .add (.C (1 / 10)) (.mul (.X 0) (.X 1))
  else .add (.C (-1 / 10)) (.mul (.X 0) (.X 0))

/-- Boundary values `u(−1) = (1/10, 1/20)` (real). -/
noncomputable def p₀ : Fin 2 → ℝ := ![1 / 10, 1 / 20]

/-- Their rational mirror. -/
def p_q : Fin 2 → ℚ := ![1 / 10, 1 / 20]

theorem hp : ∀ l, p₀ l = (p_q l : ℝ) := fun l => by
  fin_cases l <;> norm_num [p₀, p_q]

