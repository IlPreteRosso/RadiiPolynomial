/-- The candidate eigenvalue `λ̄`. -/
def lbarQ : ℚ := 839043344273 / 200000000000

/-- A numerator pair over `Dv` as a rational complex number. -/
def ofNumV (p : ℤ × ℤ) : ℚ × ℚ := ((p.1 : ℚ) / Dv, (p.2 : ℚ) / Dv)

/-- A numerator pair over `DB` as a rational complex number. -/
def ofNumB (p : ℤ × ℤ) : ℚ × ℚ := ((p.1 : ℚ) / DB, (p.2 : ℚ) / DB)

/-- **The candidate accessor** `v̄_n` (`0` off `−10, …, 10`). -/
def vbarQ (n : ℤ) : ℚ × ℚ :=
  if -10 ≤ n ∧ n ≤ 10 then ofNumV (vbarNum.getD (n + 10).toNat (0, 0)) else (0, 0)

/-- **The head block** `(M_v)_ij = B_ij`, `i, j ∈ −10, …, 10` (`0` off the head block). -/
def MvQ (i j : ℤ) : ℚ × ℚ :=
  if (-10 ≤ i ∧ i ≤ 10) ∧ (-10 ≤ j ∧ j ≤ 10) then
    ofNumB ((BNum.getD (i + 10).toNat []).getD (j + 10).toNat (0, 0))
  else (0, 0)

/-- **The border column** `(m_v)_n = B_{n★}` (`0` off the head). -/
def mvQ (n : ℤ) : ℚ × ℚ :=
  if -10 ≤ n ∧ n ≤ 10 then ofNumB ((BNum.getD (n + 10).toNat []).getD 21 (0, 0)) else (0, 0)

/-- **The border row** `ψ_n = conj B_{★n}`, so `b(ψ, ρ) = Re ∑ B_{★k} ρ_k` (`0` off the head). -/
def psiQ (n : ℤ) : ℚ × ℚ :=
  if -10 ≤ n ∧ n ≤ 10 then cconj (ofNumB ((BNum.getD 21 []).getD (n + 10).toNat (0, 0)))
  else (0, 0)

/-- **The corner** `c = Re B_{★★}`. -/
def cQ : ℚ := (ofNumB ((BNum.getD 21 []).getD 21 (0, 0))).1

/-- The imaginary part of the corner (`0`, checked in `DataChecks`). -/
def cImQ : ℚ := (ofNumB ((BNum.getD 21 []).getD 21 (0, 0))).2

