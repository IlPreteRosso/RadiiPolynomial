/-- The squared weighted norm ‖ψ_E‖² (EXACT). -/
def psiESqQ : ℚ :=
  qsum (idx 10) fun n => cnormSq (psiEQ n) * FourierDuffing.Polynomial.Numbers.weightQ n ^ 2

/-- The squared weighted norm ‖M_v v̄‖² (EXACT). -/
def MvvSqQ : ℚ :=
  qsum (idx 10) fun n => cnormSq (MvvQ n) * FourierDuffing.Polynomial.Numbers.weightQ n ^ 2

/-- The squared weighted norm ‖P_{leakRows} ψ‖² (EXACT). -/
def psiRowsSqQ : ℚ :=
  qsum (leakRowsQ 10 7) fun n => cnormSq (psiQ n) * FourierDuffing.Polynomial.Numbers.weightQ n ^ 2

/-- The squared weighted norm ‖g₁‖² (EXACT). -/
def g1SqQ : ℚ :=
  qsum (idx2 10) fun n => cnormSq (g1Q n) * FourierDuffing.Polynomial.Numbers.weightQ n ^ 2

end Mirror

/-! ### C. The constants -/

section Constants

/-- The product bound `κ = 10` of `polyRowBound`. -/
def KcQ : ℚ := 10

/-- The potential-split radius `ρ_q = 2 ρ₀` (`ε = KcQ · rhoqQ = 1/500`). -/
def rhoqQ : ℚ := 2 * FourierDuffing.Polynomial.Numbers.radiusQ

/-- The tail constant `sup_{n ∉ S} |μ_n − λ̄|⁻¹ ≤ 1/(11² − (4 − λ̄))`. -/
def tQ : ℚ := 1 / (117 + lbarQ)

/-- The tail term `t ‖β‖ ≤ t · 103/10`. -/
def TeQ : ℚ := tQ * FourierDuffing.Polynomial.Numbers.betaQ

/-- The radius `r₀ = 1/20`. -/
def r0Q : ℚ := 1 / 20

/-- Row Schur maximum of `M_v`. -/
def RMQ : ℚ := 88475203047523 / 39690000000000

/-- Column Schur maximum of `M_v`. -/
def CMQ : ℚ := 180653279 / 50000000

/-- `sqrt_up (RMQ * CMQ)`, the bound of `‖M_v‖`. -/
def sMQ : ℚ := 2837972329707 / 1000000000000

/-- `sqrt_up`, the bound of `‖m_v‖`. -/
def smQ : ℚ := 210683614267 / 200000000000

/-- `sqrt_up`, the bound of `‖ψ‖`. -/
def spsiQ : ℚ := 2069929043577 / 1000000000000

/-- `sqrt_up`, the bound of `‖v̄‖`. -/
def nvQ : ℚ := 526709034271 / 250000000000

/-- `max (sqrt_up ‖g₁‖²) |g₂|`, the finite residual bound. -/
def YfinQ : ℚ := 21211 / 250000000000

/-- Row Schur maximum of `E_SS`. -/
def REQ : ℚ := 16334372241859334167 / 3415104000000000000000000

/-- Column Schur maximum of `E_SS`. -/
def CEQ : ℚ := 393942929768843 / 50000000000000000000

/-- `sqrt_up (REQ * CEQ)`, the bound of `‖E_SS‖`. -/
def z11Q : ℚ := 1534691 / 250000000000

/-- `sqrt_up`, the bound of `‖M_v v̄‖`. -/
def nMvvQ : ℚ := 196491 / 200000000000

/-- `sqrt_up`, the bound of `‖ψ_E‖`. -/
def z21Q : ℚ := 22523551 / 250000000000

/-- `|1 + b(ψ, v̄)|` (EXACT). -/
def essQ : ℚ := 203038093797 / 50000000000000000000

/-- Row Schur maximum of the composed leak kernel of `M_v`. -/
def RHQ : ℚ := 59762397676538173149973 / 10338662880000000000000000

/-- Column Schur maximum of the composed leak kernel of `M_v`. -/
def CHQ : ℚ := 639850861861 / 100000000000000

/-- `sqrt_up (RHQ * CHQ)`, the head leakage bound. -/
def HeQ : ℚ := 1520411717 / 250000000000

/-- Row Schur maximum of the leak block. -/
def RLQ : ℚ := 357541691254259501 / 620319772800000000

/-- Column Schur maximum of the leak block. -/
def CLQ : ℚ := 40833599 / 72000000

/-- `sqrt_up (RLQ * CLQ)`, the leak block bound. -/
def sLQ : ℚ := 571739390457 / 1000000000000

/-- `sqrt_up`, the bound of `‖P_{leakRows} ψ‖`. -/
def nPsiRowsQ : ℚ := 31308769779 / 500000000000

/-- `max (sqrt_up (HeQ² + TeQ²)) (nPsiRowsQ * sLQ)`. -/
def zcQ : ℚ := 10650521933 / 125000000000

/-- The `Y₀` face constant `YfinQ + max (max sMQ tQ) spsiQ * (KcQ * rhoqQ * nvQ)` (EXACT). -/
def Y0eQ : ℚ := 1494796270567793974388597 / 125000000000000000000000000

/-- The `Z₀` face constant `max (z11Q + nMvvQ) (z21Q + essQ)` (EXACT). -/
def Z0eQ : ℚ := 4504913238093797 / 50000000000000000000

/-- The `Z₁` face constant `zcQ + max (max sMQ tQ) spsiQ * (KcQ * rhoqQ)` (EXACT). -/
def Z1eQ : ℚ := 45440060061707 / 500000000000000

/-- The `Z₂` face constant `2 * max (max sMQ tQ + smQ) (spsiQ + qabs cQ)` (EXACT). -/
def Z2eQ : ℚ := 1945695200521 / 250000000000

end Constants

/-! ### D. The checks (one call per bundle) -/

section Checks

/-- The symmetries of the data: `B[−i][−j] = conj B[i][j]` on the head block, the border
column, row and the candidate, and `Im B★★ = 0`. -/
def DataChecks : Prop :=
  (∀ i ∈ (idx 10), ∀ j ∈ (idx 10), MvQ (-i) (-j) = cconj (MvQ i j)) ∧
  (∀ n ∈ (idx 10), mvQ (-n) = cconj (mvQ n)) ∧
  (∀ n ∈ (idx 10), psiQ (-n) = cconj (psiQ n)) ∧
  (∀ n ∈ (idx 10), vbarQ (-n) = cconj (vbarQ n)) ∧
  cImQ = 0

instance : Decidable DataChecks := by
  unfold DataChecks
  infer_instance

/-- **The certificate call** for `DataChecks`: one `decide +kernel`. -/
theorem checks_data : DataChecks := by decide +kernel

/-- The `Y₀` bundle: finite residual, `M_v` Schur, `‖ψ‖`, `‖v̄‖`, the face constant. -/
def ChecksY0 : Prop :=
  g1SqQ ≤ YfinQ ^ 2 ∧
  qabs g2Q ≤ YfinQ ∧
  0 ≤ YfinQ ∧
  (∀ i ∈ (idx 10), mvRowQ i ≤ RMQ) ∧
  (∀ j ∈ (idx 10), mvColQ j ≤ CMQ) ∧
  RMQ * CMQ ≤ sMQ ^ 2 ∧
  0 ≤ RMQ ∧
  0 ≤ CMQ ∧
  0 ≤ sMQ ∧
  psiSqQ ≤ spsiQ ^ 2 ∧
  0 ≤ spsiQ ∧
  nvSqQ ≤ nvQ ^ 2 ∧
  0 ≤ nvQ ∧
  YfinQ + max (max sMQ tQ) spsiQ * (KcQ * rhoqQ * nvQ) ≤ Y0eQ

instance : Decidable ChecksY0 := by
  unfold ChecksY0
  infer_instance

/-- **The certificate call** for `ChecksY0`: one `native_decide`. -/
theorem checks_Y0 : ChecksY0 := by native_decide

/-- The `Z₀` bundle: `E_SS` Schur, `‖ψ_E‖`, `‖M_v v̄‖`, `|1 + b(ψ, v̄)|`, the face
constant. -/
def ChecksZ0 : Prop :=
  (∀ i ∈ (idx 10), defRowQ i ≤ REQ) ∧
  (∀ j ∈ (idx 10), defColQ j ≤ CEQ) ∧
  REQ * CEQ ≤ z11Q ^ 2 ∧
  0 ≤ REQ ∧
  0 ≤ CEQ ∧
  0 ≤ z11Q ∧
  psiESqQ ≤ z21Q ^ 2 ∧
  0 ≤ z21Q ∧
  MvvSqQ ≤ nMvvQ ^ 2 ∧
  0 ≤ nMvvQ ∧
  qabs (1 + bpsivQ) ≤ essQ ∧
  max (z11Q + nMvvQ) (z21Q + essQ) ≤ Z0eQ

instance : Decidable ChecksZ0 := by
  unfold ChecksZ0
  infer_instance

/-- **The certificate call** for `ChecksZ0`: one `native_decide`. -/
theorem checks_Z0 : ChecksZ0 := by native_decide

/-- The `Z₁` bundle: composed leakage Schur, leak block Schur, `‖P_{leakRows} ψ‖`, the
centre term, `M_v` Schur, `‖ψ‖`, the face constant. -/
def ChecksZ1 : Prop :=
  (∀ i ∈ (idx 10), kmvRowQ i ≤ RHQ) ∧
  (∀ k ∈ (leakColsQ 10 7), kmvColQ k ≤ CHQ) ∧
  RHQ * CHQ ≤ HeQ ^ 2 ∧
  0 ≤ RHQ ∧
  0 ≤ CHQ ∧
  0 ≤ HeQ ∧
  (∀ i ∈ (idx 10), leakRowQ i ≤ RLQ) ∧
  (∀ k ∈ (leakColsQ 10 7), leakColQ k ≤ CLQ) ∧
  RLQ * CLQ ≤ sLQ ^ 2 ∧
  0 ≤ RLQ ∧
  0 ≤ CLQ ∧
  0 ≤ sLQ ∧
  psiRowsSqQ ≤ nPsiRowsQ ^ 2 ∧
  0 ≤ nPsiRowsQ ∧
  HeQ ^ 2 + TeQ ^ 2 ≤ zcQ ^ 2 ∧
  nPsiRowsQ * sLQ ≤ zcQ ∧
  0 ≤ zcQ ∧
  0 ≤ tQ ∧
  (∀ i ∈ (idx 10), mvRowQ i ≤ RMQ) ∧
  (∀ j ∈ (idx 10), mvColQ j ≤ CMQ) ∧
  RMQ * CMQ ≤ sMQ ^ 2 ∧
  0 ≤ RMQ ∧
  0 ≤ CMQ ∧
  0 ≤ sMQ ∧
  psiSqQ ≤ spsiQ ^ 2 ∧
  0 ≤ spsiQ ∧
  zcQ + max (max sMQ tQ) spsiQ * (KcQ * rhoqQ) ≤ Z1eQ

instance : Decidable ChecksZ1 := by
  unfold ChecksZ1
  infer_instance

/-- **The certificate call** for `ChecksZ1`: one `native_decide`. -/
theorem checks_Z1 : ChecksZ1 := by native_decide

/-- The `Z₂` bundle: `M_v` Schur, `‖m_v‖`, `‖ψ‖`, the face constant. -/
def ChecksZ2 : Prop :=
  (∀ i ∈ (idx 10), mvRowQ i ≤ RMQ) ∧
  (∀ j ∈ (idx 10), mvColQ j ≤ CMQ) ∧
  RMQ * CMQ ≤ sMQ ^ 2 ∧
  0 ≤ RMQ ∧
  0 ≤ CMQ ∧
  0 ≤ sMQ ∧
  mvSqQ ≤ smQ ^ 2 ∧
  0 ≤ smQ ∧
  psiSqQ ≤ spsiQ ^ 2 ∧
  0 ≤ spsiQ ∧
  2 * max (max sMQ tQ + smQ) (spsiQ + qabs cQ) ≤ Z2eQ

instance : Decidable ChecksZ2 := by
  unfold ChecksZ2
  infer_instance

/-- **The certificate call** for `ChecksZ2`: one `native_decide`. -/
theorem checks_Z2 : ChecksZ2 := by native_decide

/-- The radii inequality at `r₀ = 1/20` and `Z₀ < 1`. -/
def ChecksRadii : Prop :=
  0 < r0Q ∧
  Z2eQ * r0Q ^ 2 - (1 - Z0eQ - Z1eQ) * r0Q + Y0eQ < 0 ∧
  Z0eQ < 1

instance : Decidable ChecksRadii := by
  unfold ChecksRadii
  infer_instance

/-- **The certificate call** for `ChecksRadii`: one `decide +kernel`. -/
theorem checks_radii : ChecksRadii := by decide +kernel

end Checks

end FourierDuffing.Polynomial.Eigenpair.Numbers
