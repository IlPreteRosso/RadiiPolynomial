/-! ### B. The mirror -/

section Mirror

/-- The finite potential `q̄_n = −2 ā_n`. -/
def qbarQ (n : ℤ) : ℚ × ℚ := cscale (-2) (leaf.abarQ n)

/-- The head Jacobian at `q̄`: `J_kj = (μ_k − λ̄) δ_kj + q̄_{k−j}`. -/
def jacQ (k j : ℤ) : ℚ × ℚ :=
  cadd (if k = j then csub (muQ k) (lbarQ, 0) else (0, 0)) (qbarQ (k - j))

/-- The head residual `ρ_k = ∑_j J_kj v̄_j`. -/
def rhoQ (k : ℤ) : ℚ × ℚ := csum (idx 10) fun j => cmul (jacQ k j) (vbarQ j)

/-- The normalization defect `η = ∑_n |v̄_n|² − 1`. -/
def etaQ : ℚ := qsum (idx 10) (fun n => cnormSq (vbarQ n)) - 1

/-- The product `(q̄ ⋆ v̄)_n = ∑_k q̄_{n−k} v̄_k`. -/
def convbQ (n : ℤ) : ℚ × ℚ := csum (idx 10) fun k => cmul (qbarQ (n - k)) (vbarQ k)

/-- The first residual component `g₁ = G₁(v̄, λ̄)` at `q̄`: `M_v ρ + η m_v` on the head,
`(μ_n − λ̄)⁻¹ (q̄ ⋆ v̄)_n` off it. -/
def g1Q (n : ℤ) : ℚ × ℚ :=
  if -10 ≤ n ∧ n ≤ 10 then
    cadd (csum (idx 10) fun k => cmul (MvQ n k) (rhoQ k)) (cscale etaQ (mvQ n))
  else cmul (cinv (csub (muQ n) (lbarQ, 0))) (convbQ n)

/-- The second residual component `g₂ = b(ψ, ρ) + c η`. -/
def g2Q : ℚ := qsum (idx 10) (fun k => (cmul (cconj (psiQ k)) (rhoQ k)).1) + cQ * etaQ

/-- The border pairing `b(ψ, v̄) = Re ∑_k conj ψ_k v̄_k`. -/
def bpsivQ : ℚ := qsum (idx 10) fun k => (cmul (cconj (psiQ k)) (vbarQ k)).1

/-- The defect block `E_SS = I − M_v J − 2 m_v v̄ᴴ` on the head. -/
def defQ (i j : ℤ) : ℚ × ℚ :=
  csub (csub (if i = j then (1, 0) else (0, 0)) (csum (idx 10) fun k => cmul (MvQ i k) (jacQ k j)))
    (cscale 2 (cmul (mvQ i) (cconj (vbarQ j))))

/-- The defect row `ψ_E = Jᴴ ψ + 2 c v̄` (`b(ψ, J x) + 2 c b(v̄, x) = b(ψ_E, x)`). -/
def psiEQ (j : ℤ) : ℚ × ℚ :=
  cadd (csum (idx 10) fun k => cmul (cconj (jacQ k j)) (psiQ k)) (cscale (2 * cQ) (vbarQ j))

/-- The defect column `M_v v̄`. -/
def MvvQ (i : ℤ) : ℚ × ℚ := csum (idx 10) fun j => cmul (MvQ i j) (vbarQ j)

/-- The composed leakage kernel of `M_v` with `β = 2ā` over the leak rows. -/
def kmvQ (i k : ℤ) : ℚ × ℚ :=
  csum (leakRowsQ 10 7) fun n => cmul (MvQ i n) (cscale 2 (leaf.abarQ (n - k)))

/-- The composed leakage kernel of the head projection with `β = 2ā` (the leak block). -/
def leakQ (i k : ℤ) : ℚ × ℚ :=
  csum (leakRowsQ 10 7) fun n =>
    cmul (if i = n then (1, 0) else (0, 0)) (cscale 2 (leaf.abarQ (n - k)))

/-- The weighted row sum of `MvQ` (UPPER for the moduli). -/
def mvRowQ (i : ℤ) : ℚ :=
