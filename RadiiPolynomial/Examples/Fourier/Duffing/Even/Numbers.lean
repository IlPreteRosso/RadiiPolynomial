/-- The weight parameter `ν = 6/5`. -/
def nuQ : ℚ := 6 / 5

/-- The damping `c₁ = 0`. -/
def c₁Q : ℚ := 0

/-- The linear coefficient `c₂ = −1`. -/
def c₂Q : ℚ := -1

/-- The forcing amplitude `c₃ = −4/5`. -/
def c₃Q : ℚ := -4 / 5

/-- The Duffing symbol `μ_n = (c₂ − n²) + i c₁ n` at `c₁ = 0`, `c₂ = −1`. -/
def muQ (n : ℤ) : ℚ × ℚ := (c₂Q - (n : ℚ) ^ 2, c₁Q * n)

/-- The forcing `c₃ b_n`, `b_{±1} = 1/2`. -/
def forcQ (n : ℤ) : ℚ × ℚ := if n = 1 ∨ n = -1 then (c₃Q / 2, 0) else (0, 0)

