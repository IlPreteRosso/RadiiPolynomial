/-- The generated upward bounds of the three `Y₀` parts. -/
def YpartC : ℕ → ℚ
  | 0 => 248439564018785 / 1000000000000000000000000000
  | 1 => 223434941708161 / 100000000000000000000000000
  | _ => 248439564018785 / 1000000000000000000000000000

