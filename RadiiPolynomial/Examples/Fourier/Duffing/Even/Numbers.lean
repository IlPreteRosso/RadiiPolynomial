  | 1 => 146278823809851 / 10000000000000
  | _ => 775978892207219 / 100000000000000000

/-- The squared tail factor `1/|μ₁₁|² = 1/14884` (EXACT; `|μ₁₁|² = 122²`). -/
def tailInvSqQ : ℚ := 1 / 14884

end Constants

/-! ### C. The leaf -/

/-- **The rational leaf** of the certificate: head `|n| ≤ 10`, band `|b| ≤ 7` of `β = 2ā`, the
weight `ν = 6/5`, the symbol and forcing mirrors, the data, the constants and the chunks. -/
abbrev leaf : QuadFourierLeafQ where
  N := 10
  B := 7
  nuQ := nuQ
  muQ := muQ
  forcQ := forcQ
  D := D
  abarNum := abarNum
  MNum := MNum
  Y0c := Y0c
  Z0c := Z0c
  Z1c := Z1c
  Z2c := Z2c
  RzC := RzC
  CzC := CzC
  RmC := RmC
  CmC := CmC
  t2Q := t2Q
  tailInvSqQ := tailInvSqQ
  y0Parts := [(y0Chunk 0, YpartC 0), (y0Chunk 1, YpartC 1), (y0Chunk 2, YpartC 2)]
  uParts := [(rowChunk 0, UpartC 0), (rowChunk 1, UpartC 1), (rowChunk 2, UpartC 2)]
  rowChunks := [rowChunk 0, rowChunk 1, rowChunk 2]
  colChunks := [leakColChunk 0, leakColChunk 1]

/-! ### D. The checks (one call per declaration: `native_decide` on the chunks, `decide +kernel`
elsewhere) -/

section Checks

/-- **The leaf obligations**: the band `7 ≤ 10`, the support of the centre in `|n| ≤ 7`, its
reality `ā_{−n} = conj ā_n`, the chunk coverage, the four combinations of record and the
nonnegativity of the constants. -/
theorem checks : leaf.Checks := by decide +kernel

/-- Evenness of the centre: `ā_{−n} = ā_n`. -/
theorem check_even : ∀ n ∈ idx 10, leaf.abarQ (-n) = leaf.abarQ n := by decide +kernel

/-- `Y₀` part 0. -/
theorem check_Y0_part_0 : qsum (y0Chunk 0) leaf.y0Term ≤ YpartC 0 := by native_decide

/-- `Y₀` part 1. -/
theorem check_Y0_part_1 : qsum (y0Chunk 1) leaf.y0Term ≤ YpartC 1 := by native_decide

/-- `Y₀` part 2. -/
theorem check_Y0_part_2 : qsum (y0Chunk 2) leaf.y0Term ≤ YpartC 2 := by native_decide

/-- `Z₀` row chunk 0. -/
theorem check_Z0_rows_0 : ∀ i ∈ rowChunk 0, leaf.z0RowQ i ≤ RzC := by native_decide

/-- `Z₀` row chunk 1. -/
theorem check_Z0_rows_1 : ∀ i ∈ rowChunk 1, leaf.z0RowQ i ≤ RzC := by native_decide

/-- `Z₀` row chunk 2. -/
theorem check_Z0_rows_2 : ∀ i ∈ rowChunk 2, leaf.z0RowQ i ≤ RzC := by native_decide

/-- `Z₀` column chunk 0. -/
theorem check_Z0_cols_0 : ∀ j ∈ rowChunk 0, leaf.z0ColQ j ≤ CzC := by native_decide

/-- `Z₀` column chunk 1. -/
theorem check_Z0_cols_1 : ∀ j ∈ rowChunk 1, leaf.z0ColQ j ≤ CzC := by native_decide

/-- `Z₀` column chunk 2. -/
theorem check_Z0_cols_2 : ∀ j ∈ rowChunk 2, leaf.z0ColQ j ≤ CzC := by native_decide

/-- Composed-kernel row chunk 0. -/
theorem check_Z1_rows_0 : ∀ i ∈ rowChunk 0, leaf.kmRowQ i ≤ RmC := by native_decide

/-- Composed-kernel row chunk 1. -/
theorem check_Z1_rows_1 : ∀ i ∈ rowChunk 1, leaf.kmRowQ i ≤ RmC := by native_decide

/-- Composed-kernel row chunk 2. -/
theorem check_Z1_rows_2 : ∀ i ∈ rowChunk 2, leaf.kmRowQ i ≤ RmC := by native_decide

/-- Composed-kernel column chunk 0. -/
theorem check_Z1_cols_0 : ∀ c ∈ leakColChunk 0, leaf.kmColQ c ≤ CmC := by native_decide

/-- Composed-kernel column chunk 1. -/
theorem check_Z1_cols_1 : ∀ c ∈ leakColChunk 1, leaf.kmColQ c ≤ CmC := by native_decide

/-- `U_row²` part 0. -/
theorem check_Z2_part_0 : qsum (rowChunk 0) (fun i => leaf.urowRowQ i ^ 2) ≤ UpartC 0 := by
  native_decide

/-- `U_row²` part 1. -/
theorem check_Z2_part_1 : qsum (rowChunk 1) (fun i => leaf.urowRowQ i ^ 2) ≤ UpartC 1 := by
  native_decide

/-- `U_row²` part 2. -/
theorem check_Z2_part_2 : qsum (rowChunk 2) (fun i => leaf.urowRowQ i ^ 2) ≤ UpartC 2 := by
  native_decide

/-- **The per-chunk obligations**, assembled from the 17 chunk checks. -/
theorem chunk_checks : leaf.ChunkChecks :=
  ⟨List.forall_mem_cons.2 ⟨check_Y0_part_0,
      List.forall_mem_cons.2 ⟨check_Y0_part_1,
        List.forall_mem_cons.2 ⟨check_Y0_part_2,
          List.forall_mem_nil _⟩⟩⟩,
   List.forall_mem_cons.2 ⟨check_Z0_rows_0,
      List.forall_mem_cons.2 ⟨check_Z0_rows_1,
        List.forall_mem_cons.2 ⟨check_Z0_rows_2,
          List.forall_mem_nil _⟩⟩⟩,
   List.forall_mem_cons.2 ⟨check_Z0_cols_0,
      List.forall_mem_cons.2 ⟨check_Z0_cols_1,
        List.forall_mem_cons.2 ⟨check_Z0_cols_2,
          List.forall_mem_nil _⟩⟩⟩,
   List.forall_mem_cons.2 ⟨check_Z1_rows_0,
      List.forall_mem_cons.2 ⟨check_Z1_rows_1,
        List.forall_mem_cons.2 ⟨check_Z1_rows_2,
          List.forall_mem_nil _⟩⟩⟩,
   List.forall_mem_cons.2 ⟨check_Z1_cols_0,
      List.forall_mem_cons.2 ⟨check_Z1_cols_1,
        List.forall_mem_nil _⟩⟩,
   List.forall_mem_cons.2 ⟨check_Z2_part_0,
      List.forall_mem_cons.2 ⟨check_Z2_part_1,
        List.forall_mem_cons.2 ⟨check_Z2_part_2,
          List.forall_mem_nil _⟩⟩⟩⟩

/-- The radii inequality at `r₀ = 1/500000`. -/
theorem check_radii_r0 : Z2c * r0 ^ 2 - (1 - Z0c - Z1c) * r0 + Y0c < 0 := by
  decide +kernel

/-- The radii inequality at `r₁ = 1/10`. -/
