/-- The `Z₀` constant of record. -/
def Z0c : ℚ := 1051 / 10 ^ 7

/-- The `Z₁` constant of record. -/
def Z1c : ℚ := 123 / 10 ^ 4

/-- The `Z₂` constant of record. -/
def Z2c : ℚ := 7654 / 1000

/-- The existence radius `r₀`. -/
def r0 : ℚ := 1 / 500000

/-- The uniqueness radius `r₁`. -/
def r1 : ℚ := 1 / 10

/-- The generated upward bound of the `Z₀` row sums. -/
def RzC : ℚ := 935177066548649 / 10000000000000000000

/-- The generated upward bound of the `Z₀` column sums. -/
def CzC : ℚ := 118054514487861 / 1000000000000000000

/-- The generated upward bound of the composed-kernel row sums. -/
def RmC : ℚ := 397584639245499 / 100000000000000000

/-- The generated upward bound of the composed-kernel column sums. -/
