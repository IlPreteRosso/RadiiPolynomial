/-! ### B. The chunks and the constants -/

section Constants

/-- The three `Y₀` chunks `−20..−4`, `−3..3`, `4..20` (at most 7 head rows each). -/
def y0Chunk : ℕ → List ℤ
  | 0 => (List.range 17).map fun (j : ℕ) => (j : ℤ) - 20
  | 1 => (List.range 7).map fun (j : ℕ) => (j : ℤ) - 3
  | _ => (List.range 17).map fun (j : ℕ) => (j : ℤ) + 4

/-- The three row chunks `−10..−4`, `−3..3`, `4..10` of the head. -/
def rowChunk (k : ℕ) : List ℤ := (List.range 7).map fun (j : ℕ) => (j : ℤ) + 7 * k - 10

/-- The two column chunks `−17..−11`, `11..17` of the band columns. -/
def leakColChunk : ℕ → List ℤ
  | 0 => (List.range 7).map fun (j : ℕ) => (j : ℤ) - 17
  | _ => (List.range 7).map fun (j : ℕ) => (j : ℤ) + 11

/-- The tail-sum bound of record `T2 = 4/2541` (the producer at `c₂ = −1` gives `121/78141 ≤ T2`). -/
def t2Q : ℚ := 4 / 2541

/-- The `Y₀` constant of record. -/
