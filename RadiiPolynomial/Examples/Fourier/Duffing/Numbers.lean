/-- The finite Jacobian `DF_{nj} = μ_n δ_{nj} − 2 ā_{n−j}` (reconstruct.py:31). -/
def DFQ (n j : ℤ) : ℚ × ℚ := csub (if n = j then muQ n else (0, 0)) (cscale 2 (abarQ (n - j)))

/-- The `Z₀` defect matrix `E = I − M DF` on the head (reconstruct.py:32–33). -/
def EQ (i j : ℤ) : ℚ × ℚ :=
  csub (if i = j then (1, 0) else (0, 0)) (csum idx fun n => cmul (MQ i n) (DFQ n j))

/-- The band columns `leakCols (headF 10) (headF 7) = {11 ≤ |k| ≤ 17}` as an explicit list. -/
