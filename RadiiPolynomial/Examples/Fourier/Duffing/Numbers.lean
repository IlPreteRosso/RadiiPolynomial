/-- The damping `c₁ = 1/10`. -/
def c₁Q : ℚ := 1 / 10

/-- The linear coefficient `c₂ = 4`. -/
def c₂Q : ℚ := 4

/-- The forcing amplitude `c₃ = 1`. -/
def c₃Q : ℚ := 1

/-- The Duffing symbol `μ_n = (c₂ − n²) + i c₁ n` at `c₁ = 1/10`, `c₂ = 4`. -/
def muQ (n : ℤ) : ℚ × ℚ := (c₂Q - (n : ℚ) ^ 2, c₁Q * n)

/-- The forcing `c₃ b_n`, `b_{±1} = 1/2`. -/
def forcQ (n : ℤ) : ℚ × ℚ := if n = 1 ∨ n = -1 then (c₃Q / 2, 0) else (0, 0)

