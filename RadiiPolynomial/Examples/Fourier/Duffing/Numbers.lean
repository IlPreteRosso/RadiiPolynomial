/-- The COMPOSED leakage kernel `K_M(i,k) = ∑_{n ∈ leakRows} M_in · 2 ā_{n−k}` (unmasked;
reconstruct.py:35 composes before the absolute values). -/
def KMQ (i k : ℤ) : ℚ × ℚ := csum leakRowsQ fun n => cmul (MQ i n) (cscale 2 (abarQ (n - k)))

/-- The raw product `(ā ⋆ ā)_n = ∑_{k ∈ head} ā_k ā_{n−k}`. -/
def convQ (n : ℤ) : ℚ × ℚ := csum idx fun k => cmul (abarQ k) (abarQ (n - k))

/-- The forcing `c₃ b_n`, `b_{±1} = 1/2`. -/
def forcQ (n : ℤ) : ℚ × ℚ := if n = 1 ∨ n = -1 then (c₃Q / 2, 0) else (0, 0)

/-- The raw residual `F_n(ā) = μ_n ā_n − (ā ⋆ ā)_n − c₃ b_n`. -/
def residQ (n : ℤ) : ℚ × ℚ := csub (csub (cmul (muQ n) (abarQ n)) (convQ n)) (forcQ n)

/-- The coefficients of `G ā`: `∑_j M_nj F_j(ā)` on the head, `F_n(ā)/μ_n` off it. -/
