/-- The weight parameter `ν = 6/5`. -/
def nuQ : ℚ := 6 / 5

/-- The parameter `a = 51/50`. -/
def aQ : ℚ := 51 / 50

/-- The diagonal `λ_k = 1/(1 + k²)` of `Λ`. -/
def lamQ (k : ℤ) : ℚ := 1 / (1 + (k : ℚ) ^ 2)

/-- The Kronecker delta on `ℤ`. -/
def deltaQ (m k : ℤ) : ℚ := if m = k then 1 else 0

/-- The absolute value on `ℚ`, by one comparison. -/
def qabs (q : ℚ) : ℚ := if q < 0 then -q else q

/-- The rational sum of a family over a list of modes. -/
def qsum (l : List ℤ) (f : ℤ → ℚ) : ℚ := (l.map f).sum

/-- The head indices `−10, …, 10`. -/
def idxH : List ℤ := (List.range 21).map fun (j : ℕ) => (j : ℤ) - 10

/-- The Taylor support `−12, …, 12`. -/
def idxK : List ℤ := (List.range 25).map fun (j : ℕ) => (j : ℤ) - 12

/-- The product support `−22, …, 22` of `ū P_n` (and the nonzero `Z₀` columns). -/
def idxUK : List ℤ := (List.range 45).map fun (j : ℕ) => (j : ℤ) - 22

/-- **The centre accessor** `ū_k` (`0` off `−10, …, 10`). -/
def ubarQ (k : ℤ) : ℚ := if -10 ≤ k ∧ k ≤ 10 then (ubarNum.getD (k + 10).toNat 0 : ℚ) / D else 0

/-- **The matrix accessor** `M_ij` (`0` off the head block). -/
def MQ (i j : ℤ) : ℚ :=
  if (-10 ≤ i ∧ i ≤ 10) ∧ (-10 ≤ j ∧ j ≤ 10) then
    ((MNum.getD (i + 10).toNat []).getD (j + 10).toNat 0 : ℚ) / D
  else 0

/-- **The Taylor-term accessor** `P_n(k)` (`0` off `−12, …, 12`). -/
def PQ (n : ℕ) (k : ℤ) : ℚ :=
  if -12 ≤ k ∧ k ≤ 12 then ((PNum.getD n []).getD (k + 12).toNat 0 : ℚ) / DP else 0

/-- The enclosure centre `Ē_k = ∑_(n ≤ 12) P_n(k)`. -/
def EQ (k : ℤ) : ℚ := ((List.range 13).map fun n => PQ n k).sum

end Data

/-! ### B. The mirror and the constants -/

section Mirror

/-- The product `(ū ⋆ P_n)_k = ∑_(i ∈ −12..12) ū_(k−i) P_n(i)` (EXACT). -/
def convQ (n : ℕ) (k : ℤ) : ℚ := qsum idxK fun i => ubarQ (k - i) * PQ n i

/-- The one-step Taylor defect `(ū ⋆ P_n)_k/(n+1) − P_(n+1)(k)` (EXACT, truncation included). -/
def tdefQ (n : ℕ) (k : ℤ) : ℚ := convQ n k / ((n : ℚ) + 1) - PQ (n + 1) k

/-- The weighted norm of the `n`-th one-step defect (EXACT). -/
def rhoPartQ (n : ℕ) : ℚ := qsum idxUK fun k => qabs (tdefQ n k) * nuQ ^ k.natAbs

/-- The weighted norm `∑ |ū_k| ν^|k|` of the centre (EXACT). -/
def normUQ : ℚ := qsum idxH fun k => qabs (ubarQ k) * nuQ ^ k.natAbs

/-- The weighted norm of `Ē` (EXACT). -/
def normEQ : ℚ := qsum idxK fun k => qabs (EQ k) * nuQ ^ k.natAbs

/-- The rational residual `F̄_k = −ū_k + λ_k (ū_k + a (Ē_k − δ_k0))`. -/
def FbarQ (k : ℤ) : ℚ := -ubarQ k + lamQ k * (ubarQ k + aQ * (EQ k - deltaQ k 0))

/-- `(A F̄)_k`: the head rows `∑_j M_kj F̄_j`, minus the identity on the tail. -/
def AFQ (k : ℤ) : ℚ := if -10 ≤ k ∧ k ≤ 10 then qsum idxH (fun j => MQ k j * FbarQ j) else -FbarQ k

/-- The weighted norm of `A F̄` (EXACT; `A F̄` lives in `−12..12`). -/
def yPartQ : ℚ := qsum idxK fun k => qabs (AFQ k) * nuQ ^ k.natAbs

/-- The head coefficient `(A† e_m)_j = −δ_mj + λ_j ((δ_mj + δ_(−m)j)/2 + a/2 (Ē_(j−m) + Ē_(j+m)))`. -/
def adagQ (m j : ℤ) : ℚ :=
  -deltaQ m j + lamQ j * ((deltaQ m j + deltaQ (-m) j) / 2 + aQ / 2 * (EQ (j - m) + EQ (j + m)))

/-- The head coefficient `((I − A A†) e_m)_k = δ_mk − ∑_j M_kj (A† e_m)_j`, `k` in the head. -/
def TQ (m k : ℤ) : ℚ := deltaQ m k - qsum idxH fun j => MQ k j * adagQ m j

/-- The head part of the `m`-th column norm of `I − A A†` (EXACT). -/
def z0ColQ (m : ℤ) : ℚ := qsum idxH fun k => qabs (TQ m k) * nuQ ^ k.natAbs

/-- The `m`-th column norm of `A Λ` on the head: `λ_m ∑_k |M_km| ν^|k|` (EXACT). -/
def lColQ (m : ℤ) : ℚ := lamQ m * qsum idxH fun k => qabs (MQ k m) * nuQ ^ k.natAbs

/-- The three `Z₀` column chunks `−22..−8`, `−7..7`, `8..22`. -/
def zChunk (c : ℕ) : List ℤ := (List.range 15).map fun (j : ℕ) => (j : ℤ) + 15 * c - 22

/-- The generated upward bounds `ρ_n` of the one-step defects. -/
def rhoC : ℕ → ℚ
  | 0 => 0
  | 1 => 31079 / 2500000000000000
  | 2 => 12709 / 500000000000000
  | 3 => 48131 / 2000000000000000
  | 4 => 77299 / 2500000000000000
  | 5 => 254721 / 10000000000000000
  | 6 => 242593 / 10000000000000000
  | 7 => 7017 / 250000000000000
  | 8 => 228429 / 10000000000000000
  | 9 => 164127 / 10000000000000000
  | 10 => 741451 / 100000000000000000
  | 11 => 29313 / 20000000000000000
  | _ => 0

/-- The generated upward bound `m ≥ ‖ū‖`. -/
def mC : ℚ := 678863 / 1000000

/-- The generated upward bound of `‖Ē‖`. -/
def EC : ℚ := 171037 / 100000

/-- The generated upward bound of `‖A F̄‖`. -/
def YAC : ℚ := 678069 / 100000000000

/-- The generated upward bound of the normalized head column norms of `I − A A†`. -/
def ZHC : ℚ := 123761 / 50000000

/-- The generated upward bound of `‖A Λ‖`. -/
def LC : ℚ := 329691 / 10000

/-- The propagated term errors `ε₀ = 0`, `ε_(n+1) = m ε_n/(n+1) + ρ_n` (EXACT recursion). -/
def epsQ : ℕ → ℚ
  | 0 => 0
  | n + 1 => mC * epsQ n / ((n : ℚ) + 1) + rhoC n

/-- The tail majorant `m^13/13! · (14/(14 − m))` of `∑_(n > 12) m^n/n!`. -/
def tailQ : ℚ := mC ^ 13 / 6227020800 * (14 / (14 - mC))

/-- The enclosure radius `δ ≥ ‖e^ū − Ē‖`. -/
def deltaC : ℚ := 1 / 4000000000

/-- The upper bound `e < 2.7182818286` of record (`Real.exp_one_lt_d9`). -/
def eC : ℚ := 13591409143 / 5000000000

/-- The `Y₀` constant of record. -/
def Y0c : ℚ := 679 / 100000000

/-- The `Z₀` constant of record. -/
def Z0c : ℚ := 1249 / 50000

/-- The `Z₁` constant of record. -/
def Z1c : ℚ := 17 / 2000000000

/-- The `Z₂` constant of record. -/
def Z2c : ℚ := 4571 / 50

/-- The existence radius `r₀`. -/
def r0 : ℚ := 1 / 100000

/-- The uniqueness radius `r₁`. -/
def r1 : ℚ := 1 / 100

end Mirror

/-! ### C. The checks (one call per declaration: `native_decide` on the chunks, `decide +kernel` elsewhere) -/

section Checks

/-- `P₀ = δ₀`. -/
theorem check_P0 : ∀ k ∈ idxK, PQ 0 k = deltaQ k 0 := by decide +kernel

/-- Evenness of the centre: `ū_(−k) = ū_k`. -/
theorem check_even : ∀ k ∈ idxH, ubarQ (-k) = ubarQ k := by decide +kernel

/-- The one-step Taylor defects, `n = 0, …, 5`. -/
theorem check_rho_0 : ∀ n ∈ List.range 6, rhoPartQ n ≤ rhoC n := by native_decide

/-- The one-step Taylor defects, `n = 6, …, 11`. -/
theorem check_rho_1 : ∀ n ∈ (List.range 6).map (· + 6), rhoPartQ n ≤ rhoC n := by native_decide

/-- `‖ū‖ ≤ m`. -/
theorem check_normU : normUQ ≤ mC := by native_decide

/-- `‖Ē‖ ≤ E`. -/
theorem check_normE : normEQ ≤ EC := by native_decide

/-- `‖A F̄‖ ≤ Y_A`. -/
theorem check_Y : yPartQ ≤ YAC := by native_decide

/-- `Z₀` head column chunk 0. -/
theorem check_Z0_cols_0 : ∀ m ∈ zChunk 0, z0ColQ m ≤ ZHC * nuQ ^ m.natAbs := by native_decide

/-- `Z₀` head column chunk 1. -/
theorem check_Z0_cols_1 : ∀ m ∈ zChunk 1, z0ColQ m ≤ ZHC * nuQ ^ m.natAbs := by native_decide

/-- `Z₀` head column chunk 2. -/
theorem check_Z0_cols_2 : ∀ m ∈ zChunk 2, z0ColQ m ≤ ZHC * nuQ ^ m.natAbs := by native_decide

/-- The head columns of `A Λ`. -/
theorem check_L_cols : ∀ m ∈ idxH, lColQ m ≤ LC * nuQ ^ m.natAbs := by native_decide

/-- The tail columns of `A Λ`: `λ_k ≤ 1/122 ≤ L`. -/
theorem check_L_tail : 1 / 122 ≤ LC := by decide +kernel

/-- The enclosure radius: `∑_(n ≤ J) ε_n + tail ≤ δ`. -/
theorem check_delta : ((List.range 13).map epsQ).sum + tailQ ≤ deltaC := by decide +kernel

/-- The `Z₀` combination: head columns plus the tail `λ₁₁ (1 + a ‖Ē‖)`. -/
theorem check_Z0 : ZHC + 1 / 122 * (1 + aQ * EC) ≤ Z0c := by decide +kernel

/-- The `Z₁` combination `a ‖A Λ‖ δ`. -/
theorem check_Z1 : aQ * LC * deltaC ≤ Z1c := by decide +kernel

/-- The `Y₀` combination `‖A F̄‖ + a ‖A Λ‖ δ`. -/
theorem check_Y0 : YAC + aQ * LC * deltaC ≤ Y0c := by decide +kernel

/-- The `Z₂` combination `a ‖A Λ‖ e`. -/
theorem check_Z2 : aQ * LC * eC ≤ Z2c := by decide +kernel

/-- `‖ū‖ + r₁ ≤ 1`, so `e^(‖ū‖ + r) ≤ e` on both balls. -/
theorem check_mr1 : mC + r1 ≤ 1 := by decide +kernel

/-- The head defect is a contraction (head injectivity of `M`). -/
theorem check_ZH : ZHC < 1 := by decide +kernel

/-- The radii inequality at `r₀`. -/
theorem check_radii_r0 : Z2c * r0 ^ 2 - (1 - Z0c - Z1c) * r0 + Y0c < 0 := by decide +kernel

/-- The radii inequality at `r₁`. -/
theorem check_radii_r1 : Z2c * r1 ^ 2 - (1 - Z0c - Z1c) * r1 + Y0c < 0 := by decide +kernel

end Checks

end FourierExponential.Numbers
