import Mathlib.Algebra.Order.Antidiag.Prod
import Mathlib.Algebra.BigOperators.GroupWithZero.Action

/-!
# Finite-fiber convolution

Let `M` be an index type with a multiplication in which every element `m` has only finitely
many factorizations `m = i * j`; the class `Finset.HasMulAntidiagonal M` provides these
factorizations as a finite set `Finset.mulAntidiagonal m`. For coefficients `R` forming an
additive commutative monoid and equipped with a multiplication, the finite-fiber convolution of
`a b : M → R` is

  `finiteMulConvolution a b m = ∑ (i, j) ∈ Finset.mulAntidiagonal m, a i * b j`.

The additive-index version `finiteAddConvolution`, generated by `to_additive`, sums over the
additive fibers `Finset.antidiagonal m` (pairs with `i + j = m`) of a type with
`Finset.HasAntidiagonal`. In both versions the coefficients are MULTIPLIED; only the index
operation changes. Every sum is finite, so the module needs no topology and no summability.

The module provides the operation, its finite-sum application formula (`apply`), and external
scalar compatibility in the first input (`smul_left`). The Cauchy product of natural-index
sequences (`RadiiPolynomial.cauchyProduct`) is its additive-index specialization on `ℕ`.
-/

open Finset

namespace RadiiPolynomial

variable {M R S : Type*}

/-- Finite-fiber convolution over a multiplicative index:
`finiteMulConvolution a b m = ∑ (i, j) ∈ mulAntidiagonal m, a i * b j`. -/
@[to_additive (dont_translate := R)
  /-- Finite-fiber convolution over an additive index:
  `finiteAddConvolution a b m = ∑ (i, j) ∈ antidiagonal m, a i * b j`. The coefficients are
  multiplied; only the index operation is additive. -/]
def finiteMulConvolution [Mul M] [HasMulAntidiagonal M] [AddCommMonoid R] [Mul R]
    (a b : M → R) : M → R :=
  fun m => ∑ ij ∈ mulAntidiagonal m, a ij.1 * b ij.2

namespace finiteMulConvolution

section Basic

variable [Mul M] [HasMulAntidiagonal M] [AddCommMonoid R] [Mul R]

@[to_additive (dont_translate := R)
  /-- Application of `finiteAddConvolution`: a finite sum over the additive fiber `antidiagonal m`,
  with the coefficients multiplied. -/]
theorem apply (a b : M → R) (m : M) :
    finiteMulConvolution a b m = ∑ ij ∈ mulAntidiagonal m, a ij.1 * b ij.2 := rfl



@[to_additive (dont_translate := S R) smul_left
  /-- External scalars in the first input of the additive-index convolution. -/]
theorem smul_left [DistribSMul S R] [IsScalarTower S R R] (c : S) (a b : M → R) :
    finiteMulConvolution (c • a) b = c • finiteMulConvolution a b :=
  funext fun _ => by simp only [apply, Pi.smul_apply, smul_mul_assoc, smul_sum]



end Basic



end finiteMulConvolution



end RadiiPolynomial
