import RadiiPolynomial.Algebra.Convolution.Basic
import RadiiPolynomial.Algebra.Convolution.CauchyProduct
import Mathlib.Topology.Algebra.InfiniteSum.Ring

/-!
# Point masses and associativity for the ring convolution

Mathlib's ring convolution `f ⋆ᵣ g` of functions `M → R` on a monoid `M`
(`Mathlib.Topology.Algebra.InfiniteSum.DiscreteConvolution`) comes with its zero laws,
distributivity, compatibility with scalars, commutativity and the unit `Pi.single 1 1`. This file
adds the point mass `delta e` with a general coefficient `e`, the product of two point masses,
the decomposition of `M × M` into multiplication fibers, and associativity of the ring
convolution under explicit summability hypotheses. The comparison with finite-fiber convolution
is owned by the finite-fiber convolution recovery record.
The additive-index versions, generated by `to_additive`, serve the Taylor (`ℕ`) and
Chebyshev (`ℤ`) sequence algebras; in them the coefficients are still multiplied.

## Main definitions

* `RadiiPolynomial.DiscreteConvolution.sigmaMulFiberEquiv`: `(Σ x, mulFiber x) ≃ M × M`.
* `RadiiPolynomial.DiscreteConvolution.delta e`: the point mass `Pi.single 1 e` at the unit.
* `RadiiPolynomial.DiscreteConvolution.tripleMulFiber x`: all triples `(a, b, c)` with
  `a * b * c = x`.
* `RadiiPolynomial.DiscreteConvolution.leftMulAssocEquiv x`,
  `RadiiPolynomial.DiscreteConvolution.rightMulAssocEquiv x`: the two nested fiber sums of a
  triple product reindexed by `tripleMulFiber x`.
* `RadiiPolynomial.DiscreteConvolution.TripleConvolutionSummable f g h x`: summability of
  `f a * g b * h c` over `tripleMulFiber x`.

## Main results

* `RadiiPolynomial.DiscreteConvolution.delta_ringConvolution'`,
  `RadiiPolynomial.DiscreteConvolution.ringConvolution_delta'`: convolving with `delta e`
  multiplies by `e` on the left or on the right.
* `RadiiPolynomial.DiscreteConvolution.single_ringConvolution_single`:
  `Pi.single i x ⋆ᵣ Pi.single j y = Pi.single (i * j) (x * y)`, on any monoid index; in the
  additive version `single_addRingConvolution_single` this includes the index `ℤ`.
* `RadiiPolynomial.DiscreteConvolution.ringConvolution_assoc`: `(f ⋆ᵣ g) ⋆ᵣ h = f ⋆ᵣ (g ⋆ᵣ h)`
  when the convolutions `f ⋆ᵣ g` and `g ⋆ᵣ h` exist (their fiber sums are summable) and the
  triple sums are summable. The coefficients form a possibly noncommutative topological
  semiring with a regular Hausdorff topology.
* `RadiiPolynomial.cauchyProduct.eq_addRingConvolution`: on the index `ℕ` the Cauchy product
  is the additive-index ring convolution.

## Implementation notes

The declarations live in `RadiiPolynomial.DiscreteConvolution`, apart from Mathlib's namespace
`DiscreteConvolution`, whose fiber lemmas are opened by name at the top of the file. The
associativity proofs work with `HasSum` and reindex along `leftMulAssocEquiv` and
`rightMulAssocEquiv` with pointwise `rfl` on destructured arguments; a function-level
definitional check through these equivalences is slow.

Each section assumes only the structure its proofs use. The point-mass laws need
`[NonUnitalNonAssocSemiring R]`. The predicate `TripleConvolutionSummable` needs
`[Mul R] [AddCommMonoid R] [TopologicalSpace R]`. The `HasSum` transfers
`hasSum_sigma_leftMulAssoc` and `hasSum_sigma_rightMulAssoc` need `[Mul R]` (left) or
`[Semigroup R]` (right) together with `[AddCommMonoid R] [TopologicalSpace R]`.
Associativity takes `[NonUnitalSemiring R] [TopologicalSpace R] [IsTopologicalSemiring R]
[T3Space R]`, the topological hypotheses of Mathlib's `tsum_mul_tsum` together with associativity
of `R` (`NonUnitalSemiring`). No commutativity and no norm is used,
so the results apply to matrix-valued coefficients as well as to normed fields. For a normed ring
the instance `IsTopologicalSemiring R` comes from `Mathlib.Analysis.Normed.Ring.Lemmas`, which
this file does not import.
-/

open scoped Topology DiscreteConvolution
open DiscreteConvolution (mulFiber mem_mulFiber ringConvolution_apply)

namespace RadiiPolynomial.DiscreteConvolution

variable {M R : Type*}

/-! ### Decomposition of `M × M` into fibers -/

section SigmaFiber

variable [Monoid M]

/-- The multiplication fibers partition `M × M`: `(Σ x, mulFiber x) ≃ M × M`, sending
`⟨x, (a, b)⟩` to `(a, b)`, with inverse `(a, b) ↦ ⟨a * b, (a, b)⟩`. -/
@[to_additive /-- The addition fibers partition `M × M`: `(Σ x, addFiber x) ≃ M × M`, sending
`⟨x, (a, b)⟩` to `(a, b)`, with inverse `(a, b) ↦ ⟨a + b, (a, b)⟩`. -/]
def sigmaMulFiberEquiv : (Σ k : M, mulFiber k) ≃ M × M where
  toFun := fun ⟨_, ab⟩ => ab.1
  invFun := fun ⟨j, l⟩ => ⟨j * l, ⟨(j, l), mem_mulFiber.mpr rfl⟩⟩
  left_inv := fun ⟨k, ⟨⟨j, l⟩, h⟩⟩ => by
    simp only [mem_mulFiber] at h; subst h; rfl
  right_inv := fun ⟨_, _⟩ => rfl

end SigmaFiber

/-! ### Point masses -/

section Delta

variable [Monoid M] [DecidableEq M] {E : Type*} [Zero E]

/-- The point mass at `1` with value `e`: `delta e 1 = e` and `delta e x = 0` for `x ≠ 1`.
Convolving with `delta e` multiplies by `e` (`delta_ringConvolution'`); `delta 1` is the unit of
the ring convolution. -/
@[to_additive addDelta
  /-- The point mass at `0` with value `e`: `addDelta e 0 = e` and `addDelta e x = 0` for
  `x ≠ 0`. Convolving with `addDelta e` multiplies by `e` (`addDelta_addRingConvolution'`);
  `addDelta 1` is the unit of the additive-index ring convolution. -/]
def delta (e : E) : M → E := Pi.single 1 e


@[to_additive (attr := simp) addDelta_zero_eq
  /-- The point mass `addDelta e` takes the value `e` at `0`. -/]
theorem delta_one_eq (e : E) : delta e (1 : M) = e := by
  simp [delta]

/-- The point mass `delta e` vanishes away from `1`. -/
@[to_additive addDelta_ne /-- The point mass `addDelta e` vanishes away from `0`. -/]
theorem delta_ne (e : E) {x : M} (hx : x ≠ 1) : delta e x = 0 := by
  simp [delta, hx.symm]

end Delta

section DeltaConvolution

variable [Monoid M] [DecidableEq M] [NonUnitalNonAssocSemiring R] [TopologicalSpace R]

/-- Convolving with the point mass `delta e` on the left multiplies by `e`:
`(delta e ⋆ᵣ f) x = e * f x`. -/
@[to_additive (dont_translate := R) addDelta_addRingConvolution'
  /-- Convolving with the point mass `addDelta e` on the left multiplies by `e`:
  `(addDelta e ⋆ᵣ₊ f) x = e * f x`. -/]
theorem delta_ringConvolution' (e : R) (f : M → R) (x : M) :
    (delta e ⋆ᵣ f) x = e * f x := by
  rw [ringConvolution_apply]
  simp only [delta, Pi.single_apply]
  rw [tsum_eq_single ⟨(1, x), by simp [mem_mulFiber]⟩]
  · simp only [↓reduceIte]
  · intro ⟨⟨a, b⟩, hab⟩ hne
    simp only [mem_mulFiber] at hab
    simp only [ne_eq, Subtype.mk.injEq, Prod.mk.injEq, not_and] at hne
    have ha : a ≠ 1 := fun h => hne h (by simp [← hab, h])
    simp [ha]

/-- Convolving with the point mass `delta e` on the right multiplies by `e`:
`(f ⋆ᵣ delta e) x = f x * e`. -/
@[to_additive (dont_translate := R) addRingConvolution_addDelta'
  /-- Convolving with the point mass `addDelta e` on the right multiplies by `e`:
  `(f ⋆ᵣ₊ addDelta e) x = f x * e`. -/]
theorem ringConvolution_delta' (f : M → R) (e : R) (x : M) :
    (f ⋆ᵣ delta e) x = f x * e := by
  rw [ringConvolution_apply]
  simp only [delta, Pi.single_apply]
  rw [tsum_eq_single ⟨(x, 1), by simp [mem_mulFiber]⟩]
  · simp only [↓reduceIte]
  · intro ⟨⟨a, b⟩, hab⟩ hne
    simp only [mem_mulFiber] at hab
    simp only [ne_eq, Subtype.mk.injEq, Prod.mk.injEq, not_and] at hne
    have hb : b ≠ 1 := fun h => hne (by simp [← hab, h]) h
    simp [hb]

end DeltaConvolution

section TwoAtoms

variable [Monoid M] [DecidableEq M] [NonUnitalNonAssocSemiring R] [TopologicalSpace R]

/-- The ring convolution of two point masses is the point mass at the product of the indices,
with the ordered product of the values:
`Pi.single i x ⋆ᵣ Pi.single j y = Pi.single (i * j) (x * y)`.

The index monoid is arbitrary: only the summand at `(i, j)` can be nonzero, so no finiteness of
the multiplication fibers is used. -/
@[to_additive (attr := simp) (dont_translate := R) single_addRingConvolution_single
  /-- The additive-index ring convolution of two point masses is the point mass at the sum of
  the indices, with the ordered product of the values:
  `Pi.single i x ⋆ᵣ₊ Pi.single j y = Pi.single (i + j) (x * y)`.

  The index monoid is arbitrary, `ℤ` included: only the summand at `(i, j)` can be nonzero, so no
  finiteness of the addition fibers is used. -/]
theorem single_ringConvolution_single (i j : M) (x y : R) :
    Pi.single i x ⋆ᵣ Pi.single j y = Pi.single (i * j) (x * y) := by
  have hzero (ab : M × M) (hab : ab ≠ (i, j)) :
      (Pi.single i x : M → R) ab.1 * (Pi.single j y : M → R) ab.2 = 0 := by
    by_cases ha : ab.1 = i
    · rw [Pi.single_eq_of_ne fun hb => hab (Prod.ext ha hb), mul_zero]
    · rw [Pi.single_eq_of_ne ha, zero_mul]
  ext k
  rw [ringConvolution_apply]
  by_cases hk : i * j = k
  · subst hk
    rw [tsum_eq_single (⟨(i, j), mem_mulFiber.mpr rfl⟩ : mulFiber (i * j))
      fun ab hne => hzero ab.1 (hne <| Subtype.ext ·)]
    simp only [Pi.single_eq_same]
  · rw [Pi.single_eq_of_ne' hk]
    refine (tsum_congr fun ab : mulFiber k => hzero ab.1 fun h => hk ?_).trans tsum_zero
    rw [← mem_mulFiber.mp ab.2, h]

end TwoAtoms

/-! ### Triple fibers -/

section TripleFiber

variable [Monoid M]

/-- The triple multiplication map `(a, b, c) ↦ a * b * c`. -/
@[to_additive /-- The triple addition map `(a, b, c) ↦ a + b + c`. -/]
def tripleMulMap : M × (M × M) → M := fun ⟨a, b, c⟩ => (a * b) * c

/-- The fiber of triple multiplication at `x`: all triples `(a, b, c)` with `a * b * c = x`. -/
@[to_additive
  /-- The fiber of triple addition at `x`: all triples `(a, b, c)` with `a + b + c = x`. -/]
def tripleMulFiber (x : M) : Set (M × M × M) := tripleMulMap ⁻¹' {x}

/-- Membership in `tripleMulFiber x`. -/
@[to_additive (attr := simp) /-- Membership in `tripleAddFiber x`. -/]
theorem mem_tripleMulFiber {x : M} {abc : M × M × M} :
    abc ∈ tripleMulFiber x ↔ abc.1 * abc.2.1 * abc.2.2 = x := Set.mem_preimage

/-- Reindexing of the left-associated nested fiber sum by the triple fiber: it sends
`((c, d), (a, b))`, where `c * d = x` and `a * b = c`, to `(a, b, d)`.

To transfer a `HasSum` along this equivalence, apply `Equiv.hasSum_iff` without a type
ascription and close the pointwise goals on destructured arguments by `rfl`:
```
(leftMulAssocEquiv x).hasSum_iff.mpr hs |>.congr_fun fun ⟨⟨⟨_,_⟩,_⟩, ⟨⟨_,_⟩,_⟩⟩ => rfl
```
Each point then reduces by evaluating `toFun` on a constructor, while a function-level
definitional check unfolds the equivalence on a generic variable and is slow. -/
@[to_additive /-- Reindexing of the left-associated nested fiber sum by the triple fiber: it
sends `((c, d), (a, b))`, where `c + d = x` and `a + b = c`, to `(a, b, d)`. -/]
def leftMulAssocEquiv (x : M) :
    (Σ cd : mulFiber x, mulFiber cd.1.1) ≃ tripleMulFiber x where
  toFun := fun ⟨⟨⟨c, d⟩, hcd⟩, ⟨⟨a, b⟩, hab⟩⟩ =>
    ⟨⟨a, b, d⟩, by
      rw [mem_tripleMulFiber]; rw [mem_mulFiber] at hcd hab; rw [← hcd, ← hab, mul_assoc]⟩
  invFun := fun ⟨⟨a, b, d⟩, habd⟩ =>
    ⟨⟨⟨a * b, d⟩, by rw [mem_mulFiber]; rw [mem_tripleMulFiber] at habd; exact habd⟩,
     ⟨⟨a, b⟩, by rw [mem_mulFiber]⟩⟩
  left_inv := fun ⟨⟨⟨_, _⟩, _⟩, ⟨⟨_, _⟩, hab⟩⟩ => by
    simp only [mem_mulFiber] at hab; subst hab; rfl
  right_inv := fun ⟨⟨_, _, _⟩, _⟩ => rfl

/-- Reindexing of the right-associated nested fiber sum by the triple fiber: it sends
`((a, e), (b, d))`, where `a * e = x` and `b * d = e`, to `(a, b, d)`.

The `HasSum` transfer pattern of `leftMulAssocEquiv` applies, with `(mul_assoc ..).symm` in
place of `rfl` since the summand is right-associated. -/
@[to_additive /-- Reindexing of the right-associated nested fiber sum by the triple fiber: it
sends `((a, e), (b, d))`, where `a + e = x` and `b + d = e`, to `(a, b, d)`. -/]
def rightMulAssocEquiv (x : M) :
    (Σ ae : mulFiber x, mulFiber ae.1.2) ≃ tripleMulFiber x where
  toFun := fun ⟨⟨⟨a, e⟩, hae⟩, ⟨⟨b, d⟩, hbd⟩⟩ =>
    ⟨⟨a, b, d⟩, by
      rw [mem_tripleMulFiber]; rw [mem_mulFiber] at hae hbd; rw [← hae, ← hbd, mul_assoc]⟩
  invFun := fun ⟨⟨a, b, d⟩, habd⟩ =>
    ⟨⟨⟨a, b * d⟩, by
      rw [mem_mulFiber]; rw [mem_tripleMulFiber] at habd; rw [← mul_assoc]; exact habd⟩,
     ⟨⟨b, d⟩, by rw [mem_mulFiber]⟩⟩
  left_inv := fun ⟨⟨⟨_, _⟩, _⟩, ⟨⟨_, _⟩, hbd⟩⟩ => by
    simp only [mem_mulFiber] at hbd; subst hbd; rfl
  right_inv := fun ⟨⟨_, _, _⟩, _⟩ => rfl

end TripleFiber

/-! ### Transfer of sums to the nested fibers -/

section HasSumBridge

variable [Monoid M] [AddCommMonoid R] [TopologicalSpace R]

/-- A sum of `f a * g b * h d` over the triple fiber is also the sum of
`(f a * g b) * h d` over the left-associated nested fibers. -/
@[to_additive (dont_translate := R)
  /-- A sum of `f a * g b * h d` over the triple addition fiber is also the sum of
  `(f a * g b) * h d` over the left-associated nested addition fibers. -/]
theorem hasSum_sigma_leftMulAssoc [Mul R] {f g h : M → R} {x : M} {a : R}
    (hs : HasSum (fun p : tripleMulFiber x => f p.1.1 * g p.1.2.1 * h p.1.2.2) a) :
    HasSum (fun p : Σ cd : mulFiber x, mulFiber cd.1.1 =>
      (f p.2.1.1 * g p.2.1.2) * h p.1.1.2) a :=
  ((leftMulAssocEquiv x).hasSum_iff.mpr hs).congr_fun
    fun ⟨⟨⟨_, _⟩, _⟩, ⟨⟨_, _⟩, _⟩⟩ => rfl

/-- A sum of `f a * g b * h d` over the triple fiber is also the sum of
`f a * (g b * h d)` over the right-associated nested fibers. -/
@[to_additive (dont_translate := R)
  /-- A sum of `f a * g b * h d` over the triple addition fiber is also the sum of
  `f a * (g b * h d)` over the right-associated nested addition fibers. -/]
theorem hasSum_sigma_rightMulAssoc [Semigroup R] {f g h : M → R} {x : M} {a : R}
    (hs : HasSum (fun p : tripleMulFiber x => f p.1.1 * g p.1.2.1 * h p.1.2.2) a) :
    HasSum (fun p : Σ ae : mulFiber x, mulFiber ae.1.2 =>
      f p.1.1.1 * (g p.2.1.1 * h p.2.1.2)) a :=
  ((rightMulAssocEquiv x).hasSum_iff.mpr hs).congr_fun
    fun ⟨⟨⟨a, _⟩, _⟩, ⟨⟨b, d⟩, _⟩⟩ => (mul_assoc (f a) (g b) (h d)).symm

end HasSumBridge

/-! ### Associativity -/

section TripleConvSummable

variable [Monoid M] [Mul R] [AddCommMonoid R] [TopologicalSpace R]

/-- The triple products `f a * g b * h c` are summable over the triple fiber at `x`. -/
@[to_additive (dont_translate := R) AddTripleConvolutionSummable
  /-- The triple products `f a * g b * h c` are summable over the triple addition fiber
  at `x`. -/]
def TripleConvolutionSummable (f g h : M → R) (x : M) : Prop :=
  Summable fun p : tripleMulFiber x => f p.1.1 * g p.1.2.1 * h p.1.2.2

end TripleConvSummable

section Associativity

variable [Monoid M] [NonUnitalSemiring R] [TopologicalSpace R] [IsTopologicalSemiring R]
  [T3Space R]

/-- The left-associated nested convolution sum at `x` equals the sum over the triple fiber. -/
@[to_additive (dont_translate := R) addRingConvolution_assoc_left
  /-- The left-associated nested additive-index convolution sum at `x` equals the sum over the
  triple addition fiber. -/]
theorem ringConvolution_assoc_left (f g h : M → R) (x : M)
    (hfg : ∀ k, Summable fun ab : mulFiber k => f ab.1.1 * g ab.1.2)
    (htriple : TripleConvolutionSummable f g h x) :
    ∑' cd : mulFiber x,
      (∑' ab : mulFiber cd.1.1, f ab.1.1 * g ab.1.2) * h cd.1.2 =
    ∑' p : tripleMulFiber x, f p.1.1 * g p.1.2.1 * h p.1.2.2 := by
  have hs := htriple.hasSum
  have hs_sigma := hasSum_sigma_leftMulAssoc hs
  have hs_iter := hs_sigma.sigma fun cd => (hfg cd.1.1).mul_right (h cd.1.2) |>.hasSum
  have hs_goal := hs_iter.congr_fun fun cd =>
    ((hfg cd.1.1).hasSum.mul_right _).tsum_eq.symm
  exact hs_goal.tsum_eq.trans hs.tsum_eq.symm

/-- The right-associated nested convolution sum at `x` equals the sum over the triple fiber. -/
@[to_additive (dont_translate := R) addRingConvolution_assoc_right
  /-- The right-associated nested additive-index convolution sum at `x` equals the sum over the
  triple addition fiber. -/]
theorem ringConvolution_assoc_right (f g h : M → R) (x : M)
    (hgh : ∀ k, Summable fun ab : mulFiber k => g ab.1.1 * h ab.1.2)
    (htriple : TripleConvolutionSummable f g h x) :
    ∑' ae : mulFiber x,
      f ae.1.1 * (∑' bd : mulFiber ae.1.2, g bd.1.1 * h bd.1.2) =
    ∑' p : tripleMulFiber x, f p.1.1 * g p.1.2.1 * h p.1.2.2 := by
  have hs := htriple.hasSum
  have hs_sigma' := hasSum_sigma_rightMulAssoc hs
  have hs_iter := hs_sigma'.sigma fun ae => (hgh ae.1.2).mul_left (f ae.1.1) |>.hasSum
  have hs_goal := hs_iter.congr_fun fun ae =>
    ((hgh ae.1.2).hasSum.mul_left _).tsum_eq.symm
  exact hs_goal.tsum_eq.trans hs.tsum_eq.symm

/-- Associativity of the ring convolution, `(f ⋆ᵣ g) ⋆ᵣ h = f ⋆ᵣ (g ⋆ᵣ h)`, when the
convolutions `f ⋆ᵣ g` and `g ⋆ᵣ h` exist (their fiber sums are summable at every point) and the
triple sums are summable at every point. -/
@[to_additive (dont_translate := R) addRingConvolution_assoc
  /-- Associativity of the additive-index ring convolution,
  `(f ⋆ᵣ₊ g) ⋆ᵣ₊ h = f ⋆ᵣ₊ (g ⋆ᵣ₊ h)`, when the convolutions `f ⋆ᵣ₊ g` and `g ⋆ᵣ₊ h` exist
  (their fiber sums are summable at every point) and the triple sums are summable at every
  point. -/]
theorem ringConvolution_assoc (f g h : M → R)
    (hfg : ∀ k, Summable fun ab : mulFiber k => f ab.1.1 * g ab.1.2)
    (hgh : ∀ k, Summable fun ab : mulFiber k => g ab.1.1 * h ab.1.2)
    (htriple : ∀ x, TripleConvolutionSummable f g h x) :
    (f ⋆ᵣ g) ⋆ᵣ h = f ⋆ᵣ (g ⋆ᵣ h) := by
  ext x
  simp only [ringConvolution_apply]
  exact (ringConvolution_assoc_left f g h x hfg (htriple x)).trans
    (ringConvolution_assoc_right f g h x hgh (htriple x)).symm

end Associativity

